{
  "name": "field-sales-command",
  "version": "0.1.0",
  "description": "Mobile sales enablement platform for field service companies",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start --clear",
    "build": "expo build:web",
    "prebuild": "expo prebuild",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "detox test e2e --configuration ios.sim.debug --cleanup",
    "test:e2e:build": "detox build-framework-cache && detox build-app --configuration ios.sim.debug",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/drawer": "^6.6.0",
    "@react-navigation/native": "^6.1.0",
    "@reduxjs/toolkit": "^1.9.7",
    "@supabase/auth-helpers-react-native": "^0.4.0",
    "@supabase/rnx-crypto": "^0.5.5",
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.6.0",
    "expo": "^50.0.0",
    "expo-background-fetch": "^12.0.0",
    "expo-constants": "^15.1.0",
    "expo-device": "^5.4.0",
    "expo-file-system": "^15.2.0",
    "expo-font": "^11.4.0",
    "expo-linear-gradient": "^12.1.0",
    "expo-location": "^16.1.0",
    "expo-notifications": "^0.20.0",
    "expo-router": "^2.4.0",
    "expo-splash-screen": "^0.24.0",
    "expo-sqlite": "^13.0.0",
    "expo-task-manager": "^11.1.0",
    "expo-web-browser": "^12.3.0",
    "lottie-react-native": "^6.4.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-keychain": "^8.1.0",
    "react-native-maps": "^1.7.1",
    "react-native-reanimated": "^3.5.0",
    "react-native-safe-area-context": "^4.7.0",
    "react-native-screens": "^3.26.0",
    "react-native-svg": "^13.14.0",
    "react-native-toast-notifications": "^2.3.0",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^2.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.3.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "detox": "^20.12.0",
    "detox-cli": "^20.12.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-universe": "^12.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-node": "^29.7.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "private": true,
  "license": "MIT",
  "expo": {
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ]
  }
}
