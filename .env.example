# === Supabase Configuration ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# === FastAPI Backend ===
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_WORKERS=4

# === Database ===
DATABASE_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# === Redis ===
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# === JDE ERP Integration ===
JDE_HOST=
JDE_USER=
JDE_PASSWORD=
JDE_ENVIRONMENT=PY910
JDE_SYNC_INTERVAL_SECONDS=3600

# === Salesforce Integration ===
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_SYNC_INTERVAL_SECONDS=1800

# === Snowflake ===
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=PUBLIC

# === Amplitude Analytics ===
AMPLITUDE_API_KEY=

# === Sentry Error Tracking ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# === OpenTelemetry ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=field-sales-command
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp

# === n8n Workflows ===
N8N_HOST=http://localhost:5678
N8N_API_KEY=

# === Trigger.dev ===
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# === Email Service ===
REACT_EMAIL_FROM=noreply@fieldsalescommand.com
RESEND_API_KEY=

# === AWS (for file uploads, if needed) ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=field-sales-command-assets

# === Mobile App ===
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AMPLITUDE_API_KEY=

# === Feature Flags ===
FEATURE_OFFLINE_MODE=true
FEATURE_GPS_TRACKING=true
FEATURE_LEADERBOARDS=true
FEATURE_ANALYTICS_DASHBOARD=true

# === Security ===
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# === Logging ===
LOG_LEVEL=DEBUG
LOG_FORMAT=json
